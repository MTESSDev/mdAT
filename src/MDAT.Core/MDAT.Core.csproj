<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MDAT</RootNamespace>
    <AssemblyName>MDAT.Core</AssemblyName>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageId>MDAT.Core</PackageId>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Authors>anisite</Authors>
    <Company>MESS</Company>
    <PackageProjectUrl>https://github.com/MTESSDev/mdAT</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MTESSDev/mdAT</RepositoryUrl>
    <Version>2.0.0-beta.7</Version>
    <Description>Markdown Auto-Tests core for .net 8+: markdown/YAML test case parsing and JSON verification, independent of any test framework.</Description>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageTags>markdown;testing;yaml;json;assert;test-automation</PackageTags>
    <PackageReleaseNotes>Beta of mdAT 2.0: framework-independent core. Own JSON comparison engine (no xunit/Quibble dependency), ignoreArrayOrder option, net8.0/net9.0/net10.0. See the migration section of the README. Beta 2: a JsonDocument or JsonElement whose root is a string holding a JSON object or array is written as that object or array again (mdAT 1.4 behaviour); parallelism and code coverage notes added to the migration guide. Beta 3: the test explorer now points each case to its title in the markdown file (or to the start of its document in a YAML file) instead of the C# method. Beta 4: a test case is named Method_Title@file.md (file name last, no path); the title of the raw output written by Verify.Assert shows readable type names (for example List of JsonNode instead of the compiler name). Beta 5: each markdown test file keeps a link to its C# test, inserted or corrected when the line of the test changes and never written again when nothing changed; the name of a case no longer repeats the name of the method; fixes for a markdown file shared by several tests. Beta 6: a case marked skipped in a markdown file is now listed and reported as ignored by the test explorer (the reason is in French on a French computer) instead of being left out of the list. Beta 7: when a case is marked selected, the other cases of the file stay in the list, ignored, instead of being hidden; a case can have categories and properties (category=Smoke,Fast priority=High in the line of its code block, tags: in the front matter of the file), kept by ignored cases too; the file of generateExpectedData is written again when another process is using it.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MDAT.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LoxSmoke.DocXml" Version="3.6.1" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="9.0.0" />
    <PackageReference Include="Moq" Version="4.18.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
    <PackageReference Include="YamlDotNet.System.Text.Json" Version="1.6.4" />
  </ItemGroup>

</Project>
